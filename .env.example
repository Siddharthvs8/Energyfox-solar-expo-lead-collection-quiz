# Postgres connection string. Added automatically when you connect a Neon
# database to the Vercel project (Storage tab → Neon). For local development
# run `vercel env pull .env.local` after linking the project.
DATABASE_URL=

# Password for /admin. Pick something long and unique.
ADMIN_PASSWORD=

# Optional: base URL encoded into the QR codes. On Vercel it defaults to the
# project's production domain, so you normally don't need this.
# SITE_URL=https://quiz.energyfox.in

# Optional: time zone for admin screens and CSV exports (default Asia/Kolkata).
# TIME_ZONE=Asia/Kolkata
